# Placeholder values only. Never copy a real key or funded seed phrase here.
ETHEREUM_SEPOLIA_CHAIN_ID=11155111
ARBITRUM_SEPOLIA_CHAIN_ID=421614
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.example
ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia-rpc.example
MST_ADDRESS=0xYOUR_MST_ADDRESS
ERC20_HTLC_ADDRESS=0xYOUR_ERC20_HTLC_ADDRESS
ETH_HTLC_ADDRESS=0xYOUR_ETH_HTLC_ADDRESS
ALICE_ADDRESS=0xYOUR_ALICE_ADDRESS
BOB_ADDRESS=0xYOUR_BOB_ADDRESS
# Optional local deployment signer. For protocol operations prefer separate
# role keys. Keep every real key in ignored .env and out of the frontend.
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
ALICE_PRIVATE_KEY=0xYOUR_ALICE_TESTNET_PRIVATE_KEY
BOB_PRIVATE_KEY=0xYOUR_BOB_TESTNET_PRIVATE_KEY

# Defaults for demonstration runs; local tests advance timestamps directly.
ETH_DURATION_SECONDS=600
MST_DURATION_SECONDS=1200
MST_INITIAL_SUPPLY=1000000
